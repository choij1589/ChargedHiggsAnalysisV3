{
  "description": "Parametric ParticleNetMD training configuration for fixed MHc=130 and mA conditioning",
  "version": "1.0",

  "parametric_config": {
    "mhc": 130,
    "ma_values": [85, 90, 95],
    "ma_center": 90.0,
    "ma_scale": 10.0,
    "signal_mass_balance": "event_count",
    "background_hypotheses": "duplicate_all",
    "pilot_max_train_events_per_fold_per_class": 1000,
    "pilot_max_eval_events_per_fold_per_class": 300,
    "data_loading_workers": 4,
    "comment": "mA is appended to graphInput as (mA - ma_center) / ma_scale. Signal samples are capped independently per mA."
  },

  "training_parameters": {
    "train_folds": [0, 1, 2],
    "valid_folds": [3],
    "test_folds": [4],
    "max_epochs": 120,
    "batch_size": 512,
    "dropout_p": 0.4,
    "early_stopping_patience": 10,
    "loss_type": "disco",
    "balance_weights": true,
    "max_events_per_fold_per_class": 50000,
    "augment_phi_rotation": true,
    "comment": "Uses the MHc130_MA90 GA-best training settings."
  },

  "disco_parameters": {
    "disco_lambda": 0.1,
    "comment": "Same DisCo setting as the MHc130_MA90 GA-best study."
  },

  "model_config": {
    "default_model": "ParticleNet",
    "nNodes": 256,
    "comment": "ParametricPN uses the same ParticleNet model with one extra graph-level mA input."
  },

  "optimization_config": {
    "optimizer": "Adam",
    "initLR": 0.0001,
    "weight_decay": 0.00003,
    "scheduler": "ReduceLROnPlateau",
    "comment": "MHc130_MA90 GA-best optimizer settings."
  },

  "background_config": {
    "mode": "groups",
    "background_groups": {
      "nonprompt": [
        "TTLL_powheg",
        "TTLL_mtop171p5_powheg",
        "TTLL_mtop173p5_powheg",
        "TTLL_TuneCP5up_powheg",
        "TTLL_TuneCP5down_powheg",
        "TTLL_TuneCP5CR1_powheg",
        "TTLL_TuneCP5CR2_powheg",
        "TTLL_hdamp_up_powheg",
        "TTLL_hdamp_down_powheg"
      ],
      "diboson": ["WZTo3LNu", "ZZTo4L_powheg"],
      "ttX": ["TTZ", "tZq"]
    },
    "backgrounds_list": [],
    "comment": "Same grouped background definition as regular ParticleNetMD."
  },

  "dataset_config": {
    "signal_prefix": "TTToHcToWAToMuMu-",
    "background_prefix": "Skim_TriLep_",
    "era_sample_mapping": {
      "WZTo3LNu": {"run2": "WZTo3LNu_amcatnlo", "run3": "WZTo3LNu_powheg"},
      "TTZ": {"run2": "TTZToLLNuNu", "run3": "TTZ_M50"}
    },
    "comment": "Existing datasets are loaded and expanded in memory; no parametric dataset files are written."
  },

  "system_config": {
    "device": "cuda",
    "debug": false,
    "comment": "device: 'cpu', 'cuda', or 'cuda:X' for specific GPU."
  },

  "output_config": {
    "results_dir": "ParametricPN",
    "comment": "Output directory within ParticleNetMD/"
  }
}
